{
  "name": "formpilot-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Privacy-first form and application auto-filler for Chrome and Edge.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "harness": "vite --config dev/vite.config.ts",
    "build:e2e": "node scripts/build-e2e.mjs",
    "e2e": "node scripts/e2e.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
